# CareerPilot AI Configuration

# App environment
ENVIRONMENT=development
LOG_LEVEL=INFO
SECRET_KEY=careerpilot_secret_jwt_key_super_secure_2026_zerops

# Database (PostgreSQL / SQLite fallback for local dev)
DATABASE_URL=sqlite+aiosqlite:///./careerpilot.db
# For PostgreSQL: postgresql+asyncpg://user:password@localhost:5432/careerpilot

# LLM / AI Configuration (Gemini / OpenAI / Anthropic or fallback mock)
LLM_PROVIDER=gemini
LLM_API_KEY=your_llm_api_key_here
LLM_MODEL=gemini-2.5-flash

# CORS
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]
